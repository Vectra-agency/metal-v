{
  "name": "metal-calc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Быстрый расчёт стоимости деталей: металл + лазерная резка + гибка по DXF",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "serve": "vite build && node server/index.ts",
    "prices": "node scripts/update-prices.ts",
    "calibrate": "node scripts/calibrate.ts",
    "analyze": "node scripts/analyze.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
