    "prices": "node scripts/update-prices.ts",
    "calibrate": "node scripts/calibrate.ts",
    "check-invoices": "node scripts/check-invoices.ts",
    "analyze": "node scripts/analyze.ts",
    "analyze-pdf": "node scripts/analyze-pdf.ts"
  },
  "engines": {
    "node": ">=23.6"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "0.4.0",
    "lucide-react": "1.50.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "shadcn": "4.21.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
