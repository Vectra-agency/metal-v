{
  "name": "metal-calc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Быстрый расчёт стоимости деталей: металл + лазерная резка + гибка по DXF",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
