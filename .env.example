# ИИ-анализ заказа (server/llm.ts, server/ai.ts). Без ключа калькулятор работает как раньше:
# шаг «Анализ ИИ» пропускается с пояснением.
#
# Локально: скопируйте в .env рядом с package.json — npm run dev / npm start прочитают его сами
#   (переменные окружения важнее файла).
# В проде: /var/www/metal-v/.env — docker compose подставит переменные в контейнер (docker-compose.yml);
#   после правки: docker compose up -d. Файл .env не попадает ни в git, ни в Docker-образ.

# PoYo AI (https://poyo.ai, документация https://docs.poyo.ai) — как в video-creator. Достаточно ключа:
# адрес https://api.poyo.ai/v1 и модели ниже подставятся сами. Ключ — https://poyo.ai/dashboard/api-key,
# баланс в кредитах (1 кредит = $0,005). Сайт открыт без входа: сервер сам пускает не больше
# 20 анализов в час с одного адреса и 2 запроса к модели одновременно.
POYO_API_KEY=

# --- необязательные (значения по умолчанию для PoYo) ---
# Основная модель: Claude Haiku 5.5 — дешёвая ($0,08 за 1 млн входных и $0,40 за 1 млн выходных токенов),
# читает изображения чертежей, отвечает строго по JSON-схеме (через Anthropic Messages /v1/messages),
# на ней отлажен промпт. Один анализ ≈ $0,003–0,01 (изображение 1600 px — ещё ≈ 2,5 тыс. токенов).
# Стоимость каждого анализа видна в карточке ИИ и в логе сервера.
# LLM_MODEL=claude-haiku-5-5
# Резервные модели через запятую: если основная не ответила (сбой, перегрузка, тайм-аут, снята с
# каталога), сервер по очереди пробует следующую. По умолчанию — Gemini 3.8 Flash ($0,60 / $3,00 за
# 1 млн токенов): другой поставщик, тоже видит чертежи. Такой анализ интерфейс помечает «резервная
# модель». none — без резерва: при сбое основной анализ завершится ошибкой, расчёт без ИИ останется.
# LLM_FALLBACK_MODELS=gemini-3.8-flash
# Сколько ждать ответа одной модели, мс (по умолчанию 150000). Весь анализ — не дольше
# (2 + число резервных) × LLM_TIMEOUT_MS; браузер всё это время опрашивает задачу.
# LLM_TIMEOUT_MS=150000
# Лимит длины ответа модели, токенов (по умолчанию 12000).
# LLM_MAX_TOKENS=12000
# Изображения чертежей: auto — если модель их принимает (у PoYo — Claude и Gemini), on — всегда,
# off — никогда (дешевле, но ИИ не видит чертёж).
# LLM_VISION=auto
# Формат ответа: schema — JSON по схеме (по умолчанию), object — любой JSON, off — без формата.
# Если модель отклонит формат, сервер сам повторит без него.
# LLM_JSON=schema

# --- другие сервисы (вместо PoYo, с теми же переменными) ---
# Явный LLM_BASE_URL важнее POYO_API_KEY; ключ тогда — LLM_API_KEY.
#   Hubris — российский шлюз, оплата в рублях, резерв через массив models на стороне шлюза:
#     LLM_BASE_URL=https://api.hubris.pw/v1
#     LLM_MODEL=anthropic/claude-haiku-5.5
#     LLM_API_KEY=sk-gw-…
#     LLM_FALLBACK_MODELS=google/gemma-4-31b-it:free
#   OpenAI напрямую:
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini

# --- только для разработки, никогда не включайте в проде ---
# Заглушка вместо модели, без запросов к сервису: 1 — готовый ответ (очередь, лимиты, интерфейс),
# broken — первый ответ обрезан (проверка исправления JSON), fail — ошибка 502.
# LLM_MOCK=1
# Задержка ответа заглушки, мс (по умолчанию 1500).
# LLM_MOCK_DELAY_MS=1500
