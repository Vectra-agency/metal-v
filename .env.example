# ИИ-анализ заказа (server/llm.ts, server/ai.ts). Без LLM_BASE_URL, LLM_MODEL и LLM_API_KEY
# калькулятор работает как раньше: шаг «Анализ ИИ» пропускается с пояснением.
#
# Локально: скопируйте в .env рядом с package.json — npm run dev / npm start прочитают его сами
#   (переменные окружения важнее файла).
# В проде: /var/www/metal-v/.env — docker compose подставит переменные в контейнер (docker-compose.yml);
#   после правки: docker compose up -d. Файл .env не попадает ни в git, ни в Docker-образ.

# Рекомендуем Hubris — российский OpenAI-совместимый шлюз: работает с RU-сервера без прокси,
# оплата в рублях (https://hubris.pw, документация https://hubris.pw/llms.txt).
# Заведите отдельный ключ «metal-v» на https://hubris.pw/keys и поставьте ему суточный лимит
# расходов (например, 100 ₽): сайт открыт без входа, и лимит ключа — последняя защита бюджета
# (сервер сам пускает не больше 20 анализов в час с одного адреса и 2 запроса к модели одновременно).
LLM_BASE_URL=https://api.hubris.pw/v1
# Claude Haiku 5.5: читает изображения чертежей, отвечает JSON по схеме; ≈ 12,6 ₽ за 1 млн входных
# и ≈ 63 ₽ за 1 млн выходных токенов. Один анализ ≈ 0,3–2 ₽ (заказ из 7 позиций с заявкой — ≈ 0,45 ₽
# без изображений; каждое изображение 1600 px — ещё ≈ 2,5 тыс. токенов). Стоимость каждого анализа
# видна в карточке ИИ и в логе сервера.
LLM_MODEL=anthropic/claude-haiku-5.5
LLM_API_KEY=
# Резервные модели через запятую (массив models шлюза): пробуются по порядку, если основная
# недоступна или перегружена; платится только ответившая. Бесплатные (:free) стоят 0 ₽, но дают
# 100 запросов в сутки на пользователя, бывают 429 в часы пик, и анализ у них заметно слабее —
# такой анализ интерфейс помечает «резервная модель». Пустое значение — без резервных: при сбое
# основной модели анализ завершится ошибкой, расчёт без ИИ останется.
# Снятые с каталога модели (404 model_not_found) сервер сам выкидывает из цепочки — смотрите лог.
LLM_FALLBACK_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free

# --- необязательные ---
# Сколько ждать ответа модели на один запрос, мс (по умолчанию 150000). Весь анализ с повтором
# и исправлением JSON — не дольше 2 × LLM_TIMEOUT_MS; браузер всё это время опрашивает задачу.
# LLM_TIMEOUT_MS=150000
# Лимит длины ответа модели, токенов (по умолчанию 12000).
# LLM_MAX_TOKENS=12000
# Изображения чертежей: auto — если основная модель их принимает (по справочнику
# GET {LLM_BASE_URL}/models, кэш на час), on — всегда, off — никогда (дешевле, но ИИ не видит чертёж).
# LLM_VISION=auto
# Формат ответа: schema — JSON по схеме (response_format json_schema, по умолчанию), object — любой
# JSON (json_object), off — без response_format. Если шлюз отклонит формат, сервер сам повторит без него.
# LLM_JSON=schema

# Другие шлюзы (с теми же переменными):
#   OpenRouter — те же id моделей и LLM_FALLBACK_MODELS, но с RU-сервера заблокирован:
#     LLM_BASE_URL=https://openrouter.ai/api/v1
#   OpenAI напрямую (резервные модели не поддерживаются):
#     LLM_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o-mini

# --- только для разработки, никогда не включайте в проде ---
# Заглушка вместо модели, без запросов к шлюзу: 1 — готовый ответ (очередь, лимиты, интерфейс),
# broken — первый ответ обрезан (проверка исправления JSON), fail — ошибка 502.
# LLM_MOCK=1
# Задержка ответа заглушки, мс (по умолчанию 1500).
# LLM_MOCK_DELAY_MS=1500
